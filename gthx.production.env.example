# Settings for the production gthx container (compose.gthx.yaml). Copy to gthx.production.env.
#
# These start out pointing at the local test IRC server, for a cutover rehearsal. To cut over, comment
# out the "Local test server" lines and uncomment the "Libera" ones.

# Local test server (TLS listener from testing/tls/README.md)
IrcInfo__Server=10.0.0.125
IrcInfo__Port=6697
IrcInfo__Channels=#gthxtestchannel
IrcInfo__TrustedCaCertificate=/certs/ca.pem

# Libera
#IrcInfo__Server=irc.libera.chat
#IrcInfo__Port=6697
#IrcInfo__Channels=#reprap,#bigdelta,#mobious,#smoothieware,#gthxtest,#dlp3dprinting,#slic3r,#siderala,#reprap.de

IrcInfo__UseSsl=true
IrcInfo__Nick=gthx
IrcInfo__RealName=Gthx Reprap Factoid Bot
# NickServ password for SASL. The local test server's NickServ has its own registration (see
# testing/services/README.md), so this changes at cutover too.
IrcInfo__SaslPassword=
# Minutes to wait before exiting after the connection ends, so container restarts can't turn a
# failure into a rapid reconnect loop (which can get the host banned). Defaults shown.
#IrcInfo__BannedExitDelayMinutes=60
#IrcInfo__SaslFailureExitDelayMinutes=15
#IrcInfo__EarlyFailureExitDelayMinutes=5
#IrcInfo__DisconnectExitDelayMinutes=0.5
# Minutes connected before a disconnect counts as normal rather than an early failure
#IrcInfo__StableConnectionMinutes=5

# Azure SQL production database
ConnectionStrings__GthxDb=Server=tcp:gthxdb.database.windows.net,1433;Initial Catalog=Gthx;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
ConnectionStrings__GthxDb_Type=sqlserver
