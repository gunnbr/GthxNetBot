# Settings for the gthxtestbot container (compose.gthxtestbot.yaml). Copy to gthxtestbot.env.
# Never point a test bot at Libera or another public network; use the local test server.
IrcInfo__Server=10.0.0.125
IrcInfo__Port=6667
IrcInfo__UseSsl=false
IrcInfo__Channels=#gthxtestchannel
IrcInfo__Nick=gthxtestbot
IrcInfo__RealName=Reprap Factoid Test Bot
# NickServ password for SASL; leave empty while the test server has no services
IrcInfo__SaslPassword=

# Azure SQL test database (never the one the production gthx container uses)
ConnectionStrings__GthxDb=Server=tcp:gthxdb.database.windows.net,1433;Initial Catalog=<test database>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
ConnectionStrings__GthxDb_Type=sqlserver
