<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-off tool that copies othx's data from MariaDB (othxnet on sakura) into SQL Server. See README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Gthx.Data\SqlServerMigrations\SqlServerMigrations.csproj" />
  </ItemGroup>

</Project>
