# Values in here override the defaults in the GthxNetBot/appsettings.json file
# You can modify these values to suit your needs or make environment variables with these names
# to override
IrcInfo__Channels=#gthxtestchannel
IrcInfo__Nick=gthxtester
IrcInfo__RealName=Reprap Factoid Test Bot
# For testing, point this at a private IRC server rather than a public network, which may ban
# test clients. A plaintext test server needs IrcInfo__Port=6667 and IrcInfo__UseSsl=false.
IrcInfo__Server=irc.libera.chat
IrcInfo__Port=6697
IrcInfo__UseSsl=true
# NickServ password for IrcInfo__Nick, used for SASL PLAIN login
IrcInfo__SaslPassword=

# Connection string for SQL Server (ignored by compose.yaml, which uses its own SQL Server container)
ConnectionStrings__GthxDb=

EmailConfiguration__UserName=
EmailConfiguration__Password=
EmailConfiguration__MailServer=
EmailConfiguration__Port=
